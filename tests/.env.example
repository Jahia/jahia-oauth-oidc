# Copy to .env and fill in. Read by docker compose.

# Jahia image to test against.
JAHIA_IMAGE=ghcr.io/jahia/jahia-ee-dev:8-SNAPSHOT

# root password for the instance.
SUPER_USER_PASSWORD=root1234

# Base64 of your Jahia EE license file, on a single line:
#   base64 -i /path/to/license.xml | tr -d '\n'
JAHIA_LICENSE=

# Memory ceiling for the Jahia container.
JAHIA_MEM_LIMIT=4g
