# Copy to .env and fill in. Read by docker compose and by set-env.sh.
# CI leaves .env absent and uses these defaults, overridden by the workflow environment.

JAHIA_IMAGE=${JAHIA_IMAGE:-ghcr.io/jahia/jahia-ee-dev:8-SNAPSHOT}
TESTS_IMAGE=${TESTS_IMAGE:-jahia/jahia-oauth-oidc-test:latest}
MODULE_ID=${MODULE_ID:-jahia-oauth-oidc}
MANIFEST=${MANIFEST:-provisioning-manifest-build.yml}
JAHIA_URL=${JAHIA_URL:-http://localhost:8080}
SUPER_USER_PASSWORD=${SUPER_USER_PASSWORD:-root1234}
NEXUS_USERNAME=${NEXUS_USERNAME:-NEXUS_USERNAME}
NEXUS_PASSWORD=${NEXUS_PASSWORD:-NEXUS_PASSWORD}

# Base64 of your Jahia EE license file, on a single line:
#   base64 -i /path/to/license.xml | tr -d '\n'
JAHIA_LICENSE=${JAHIA_LICENSE:-""}

# Where the BROWSER reaches Keycloak. Must match KC_HOSTNAME in docker-compose.yml.
# Running Cypress from the host (the local default) that is localhost; in CI the browser
# is inside the cypress container and ci.startup.sh overrides this to http://keycloak:8081.
KEYCLOAK_PUBLIC_URL=${KEYCLOAK_PUBLIC_URL:-http://localhost:8081}

# Memory ceiling for the Jahia container.
JAHIA_MEM_LIMIT=${JAHIA_MEM_LIMIT:-4g}
