<?xml version="1.0" encoding="UTF-8"?>
<content xmlns:j="http://www.jahia.org/jahia/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0">
    <modules jcr:primaryType="jnt:modules">
        <jahia-oauth-oidc j:dependencies="jahia-authentication jahia-oauth"
                          j:modulePriority="0"
                          j:moduleType="module"
                          j:title="jahia-oauth-oidc"
                          jcr:primaryType="jnt:module">
            <portlets jcr:primaryType="jnt:portletFolder"/>
            <files jcr:primaryType="jnt:folder"/>
            <contents jcr:primaryType="jnt:contentFolder"/>
            <templates j:rootTemplatePath="/base" jcr:primaryType="jnt:templatesFolder">
                <files jcr:primaryType="jnt:folder"/>
                <contents jcr:primaryType="jnt:contentFolder"/>
                <oauth-oidc-view jcr:primaryType="jnt:contentTemplate">
                    <pagecontent jcr:primaryType="jnt:contentList">
                        <oidcoauthview jcr:primaryType="jcauthnt:oauthOidcView"/>
                    </pagecontent>
                </oauth-oidc-view>
                <!-- A login page for any site, whatever its template set: /sites/<siteKey>.oidc-login.html -->
                <oidc-login-base j:view="oidcLogin" jcr:primaryType="jnt:template">
                    <oidc-login j:applyOn="jnt:virtualsite"
                                j:defaultTemplate="false"
                                j:hiddenTemplate="false"
                                jcr:primaryType="jnt:contentTemplate">
                        <pagecontent jcr:primaryType="jnt:contentList">
                            <oidc-login-providers autoRedirect="false" jcr:primaryType="jcauthnt:oidcLoginProviders"/>
                        </pagecontent>
                    </oidc-login>
                </oidc-login-base>
            </templates>
        </jahia-oauth-oidc>
    </modules>
</content>
