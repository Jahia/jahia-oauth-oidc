<?xml version="1.0" encoding="UTF-8" ?>

<taglib xmlns="http://java.sun.com/xml/ns/j2ee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd"
        version="2.0">

    <description>Jahia OAuth OIDC tags library</description>
    <display-name>Jahia OAuth OIDC tags</display-name>
    <tlib-version>2.0</tlib-version>
    <short-name>oidc</short-name>
    <uri>http://www.jahiacommunity.org/tags/oauth-oidc</uri>
    <function>
        <description>The enabled OIDC providers of a site, in display order</description>
        <name>loginProviders</name>
        <function-class>org.jahiacommunity.modules.oauth.oidc.tag.OidcFunctions</function-class>
        <function-signature>java.util.List loginProviders(java.lang.String)</function-signature>
    </function>
    <function>
        <description>Every OIDC provider of a site, enabled or not, in display order</description>
        <name>allProviders</name>
        <function-class>org.jahiacommunity.modules.oauth.oidc.tag.OidcFunctions</function-class>
        <function-signature>java.util.List allProviders(java.lang.String)</function-signature>
    </function>
    <function>
        <description>The cache dependency of the fragments that list the OIDC providers of a site</description>
        <name>cacheDependency</name>
        <function-class>org.jahiacommunity.modules.oauth.oidc.tag.OidcFunctions</function-class>
        <function-signature>java.lang.String cacheDependency(java.lang.String)</function-signature>
    </function>
    <function>
        <description>Makes the page being rendered depend on the OIDC providers of its site, for a template view</description>
        <name>addPageCacheDependency</name>
        <function-class>org.jahiacommunity.modules.oauth.oidc.tag.OidcFunctions</function-class>
        <function-signature>java.lang.String addPageCacheDependency(org.jahia.services.render.RenderContext)</function-signature>
    </function>
</taglib>
